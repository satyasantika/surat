APP_VERSION=1.0.0
APP_NAME="Persuratan FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=surat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lokal lewat compose pusat: http://localhost:8028 | lokal lewat gateway: http://localhost:8080/surat
# Produksi: https://supportfkip.unsil.ac.id/surat (ASSET_URL sama, SESSION_PATH=/surat, SESSION_SECURE_COOKIE=true)
APP_URL=http://localhost:8028
ASSET_URL=http://localhost:8028

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB native di host (dijangkau container lewat host.docker.internal)
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_surat
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=surat_session
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=*
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=surat_cache_

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="persuratan@unsil.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# dicabut bersama Horizon
HORIZON_EMAILS=

# PDF: dompdf bawaan (Gotenberg hanya cadangan lewat ADR). Naskah resmi selalu dompdf (deterministik, hash).
PDF_DRIVER=dompdf
PDF_DRIVER_NASKAH=dompdf

ASET_API_URL=
ASET_API_TOKEN=

WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
