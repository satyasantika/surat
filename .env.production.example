# Produksi — salin ke .env di server (chmod 600). JANGAN commit .env. Tidak ada rahasia di berkas contoh ini.
APP_VERSION=1.0.0
APP_NAME="Persuratan FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=surat
APP_ENV=production
APP_DEBUG=false
# Buat sekali: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show   (SIMPAN salinan aman: kunci
# ini mengenkripsi data pribadi pengurus, penanggung jawab, dan rahasia MFA; kehilangannya membuat data tak terbaca).
APP_KEY=

# Subpath produksi (STANDAR-TEKNIS §2.4): APP_URL = ASSET_URL; aset dibangun dengan ASSET_URL yang sama.
APP_URL=https://supportfkip.unsil.ac.id/surat
ASSET_URL=https://supportfkip.unsil.ac.id/surat
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB native di host (dijangkau container lewat host.docker.internal). Buat DB dan pengguna khusus aplikasi.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_surat
DB_USERNAME=app
DB_PASSWORD=

# Cookie sesi ber-path /surat dan hanya HTTPS. TRUSTED_PROXIES = IP reverse proxy fakultas (bukan *).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/surat
SESSION_COOKIE=surat_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=surat_cache_

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

# Surel keluar lewat SMTP fakultas
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="persuratan@unsil.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
KODE_UNIT=UN58.10

# PDF: dompdf bawaan (Gotenberg hanya cadangan lewat ADR). Naskah resmi selalu dompdf (deterministik, hash).
PDF_DRIVER=dompdf
PDF_DRIVER_NASKAH=dompdf

# Integrasi sistem Aset (kosong = ruangan lokal)
ASET_API_URL=
ASET_API_TOKEN=

# WhatsApp opsional (aktif bila pengaturan wa_aktif menyala di panel). Token: rotasi berkala (docs/DEPLOY.md §7).
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Docker (opsional)
SURAT_VERSI=1.0.0
HTTP_PORT=8028
BACKUP_DIR=./backups
BACKUP_RETENSI_HARI=30
